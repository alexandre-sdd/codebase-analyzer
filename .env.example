# API
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Optional: only allow analyzing repos under this root
# ALLOWED_REPO_ROOT=/Users/you/code

# Optional: override default jobs dir (default: apps/api/.jobs)
# JOBS_DIR=/tmp/cba-jobs

# Frontend dev origin(s) (comma-separated)
# CORS_ORIGINS=http://localhost:5173

# Claude/LLM integration
LLM_PROVIDER=mock
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01

# Crawl limits
# MAX_FILES=20000
# MAX_IMPORT_SCAN_FILES=800
# MAX_BYTES_PER_FILE=200000

