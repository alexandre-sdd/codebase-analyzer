# API
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Optional: only allow analyzing repos under this root
# ALLOWED_REPO_ROOT=/Users/you/code

# Optional: override default jobs dir (default: apps/api/.jobs)
# JOBS_DIR=/tmp/cba-jobs

# Frontend dev origin(s) (comma-separated)
# CORS_ORIGINS=http://localhost:5173

# Claude/LLM integration (required)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01

# Crawl limits
# MAX_FILES=20000
# MAX_IMPORT_SCAN_FILES=800
# MAX_BYTES_PER_FILE=200000

# ElevenLabs TTS integration (required for podcast generation)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_turbo_v2_5
